@page
@model RacehubApi.Pages.Admin.EditRaceModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit TrailRunning</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #003d5c;
            --secondary: #007f80;
            --accent: #ff6b6b;
            --light: #f8f9fa;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #e8ecf1; }

        .form-container {
            max-width: 800px; margin: 2rem auto; padding: 2rem;
            background: var(--light); border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .page-title {
            color: var(--primary); margin-bottom: 2rem;
            padding-bottom: 1rem; border-bottom: 2px solid var(--secondary);
        }
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
        .form-group { margin-bottom: 16px; }
        .form-group.full { grid-column: 1 / -1; }
        .form-group label { display: block; font-weight: 600; margin-bottom: 6px; color: var(--primary); }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 8px;
            font-size: 0.95rem; transition: border-color 0.2s;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            outline: none; border-color: var(--secondary); box-shadow: 0 0 0 3px rgba(0,127,128,0.15);
        }
        .btn-submit {
            background: linear-gradient(135deg, var(--secondary), var(--primary));
            border: none; color: white; padding: 12px 30px; border-radius: 8px;
            cursor: pointer; font-weight: 600; font-size: 1rem;
            transition: transform 0.2s; width: 100%; margin-top: 10px;
        }
        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0,127,128,0.3); }
        .btn-back {
            background: var(--secondary); color: white; padding: 10px 20px;
            border-radius: 8px; text-decoration: none; display: inline-block;
            margin-top: 1rem; transition: all 0.3s ease; font-weight: 600;
        }
        .btn-back:hover { background: var(--primary); transform: translateY(-2px); }
        .alert-error {
            background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24;
            padding: 12px 20px; border-radius: 8px; margin-bottom: 15px;
        }
        .file-upload {
            border: 2px dashed #ccc; border-radius: 8px; padding: 20px;
            text-align: center; cursor: pointer; transition: border-color 0.2s;
        }
        .file-upload:hover { border-color: var(--secondary); }
        .file-upload input[type="file"] { display: none; }
        .file-upload .icon { font-size: 2rem; color: #aaa; margin-bottom: 8px; }
        .file-upload p { color: #666; font-size: 0.9rem; }
        .current-image { max-height: 150px; border-radius: 8px; margin-bottom: 10px; }
    </style>
</head>
<body>
    <div class="form-container">
        <h1 class="page-title">
            <i class="fas fa-edit"></i>
            Edit TrailRunning
        </h1>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert-error">@Model.ErrorMessage</div>
        }

        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="RaceId" value="@Model.RaceId" />
            
            @if (Model.HasParticipants)
            {
                <div class="alert-warning" style="background: #fff3cd; color: #856404; padding: 10px; border-radius: 4px; margin-bottom: 20px;">
                    <i class="fas fa-exclamation-triangle"></i> Esta carrera tiene @Model.ParticipantCount participantes. Algunos campos están bloqueados por seguridad.
                </div>
            }

            <div class="form-grid">
                <div class="form-group full">
                    <label for="name">Nombre *</label>
                    <input id="name" name="Name" type="text" required value="@Model.Name">
                </div>
                <div class="form-group full">
                    <label for="description">Descripción</label>
                    <textarea id="description" name="Description" rows="3">@Model.Description</textarea>
                </div>
                <div class="form-group">
                    <label for="date">Fecha y Hora @(!Model.HasParticipants ? "*" : "")</label>
                    <input id="date" name="Date" type="datetime-local" required="@(!Model.HasParticipants)" value="@Model.Date.ToString("yyyy-MM-ddTHH:mm")" @(Model.HasParticipants ? "readonly" : "")>
                </div>
                <div class="form-group">
                    <label for="distanceKm">Distancia (km) @(!Model.HasParticipants ? "*" : "")</label>
                    <input id="distanceKm" name="DistanceKm" type="number" min="1" required="@(!Model.HasParticipants)" value="@Model.DistanceKm" @(Model.HasParticipants ? "readonly" : "")>
                </div>
                <div class="form-group">
                    <label for="location">Ubicación *</label>
                    <input id="location" name="Location" type="text" required value="@Model.Location">
                </div>
                <div class="form-group">
                    <label for="coordinates">Coordenadas</label>
                    <input id="coordinates" name="Coordinates" type="text" value="@Model.Coordinates">
                </div>
                <div class="form-group">
                    <label for="unevenness">Desnivel positivo (m)</label>
                    <input id="unevenness" name="Unevenness" type="number" min="0" value="@Model.Unevenness" @(Model.HasParticipants ? "readonly" : "")>
                </div>
                <div class="form-group">
                    <label for="entryFee">Precio inscripción (€) @(!Model.HasParticipants ? "*" : "")</label>
                    <input id="entryFee" name="EntryFee" type="number" min="0" required="@(!Model.HasParticipants)" value="@Model.EntryFee" @(Model.HasParticipants ? "readonly" : "")>
                </div>
                <div class="form-group">
                    <label for="availableSlots">Plazas disponibles *</label>
                    <input id="availableSlots" name="AvailableSlots" type="number" min="1" required value="@Model.AvailableSlots">
                </div>
                <div class="form-group">
                    <label for="status">Estado *</label>
                    <select id="status" name="Status">
                        <option value="open" selected="@(Model.Status == "open")">Open</option>
                        <option value="closed" selected="@(Model.Status == "closed")">Closed</option>
                        <option value="completed" selected="@(Model.Status == "completed")">Completed</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="category">Categorías</label>
                    <select id="category" name="SelectedCategories" multiple style="height: 120px;">
                        <option value="Trail Medio" selected="@(Model.SelectedCategories != null && Model.SelectedCategories.Contains("Trail Medio"))">Trail Medio</option>
                        <option value="Ultra Trail" selected="@(Model.SelectedCategories != null && Model.SelectedCategories.Contains("Ultra Trail"))">Ultra Trail</option>
                        <option value="Maratón de Montaña" selected="@(Model.SelectedCategories != null && Model.SelectedCategories.Contains("Maratón de Montaña"))">Maratón de Montaña</option>
                        <option value="Trail Costero" selected="@(Model.SelectedCategories != null && Model.SelectedCategories.Contains("Trail Costero"))">Trail Costero</option>
                        <option value="Trail Corto" selected="@(Model.SelectedCategories != null && Model.SelectedCategories.Contains("Trail Corto"))">Trail Corto</option>
                        <option value="Trail Técnico" selected="@(Model.SelectedCategories != null && Model.SelectedCategories.Contains("Trail Técnico"))">Trail Técnico</option>
                    </select>
                    <small>Mantén pulsado Ctrl para seleccionar varias</small>
                </div>
                <div class="form-group">
                    <label for="gender">Género @(!Model.HasParticipants ? "*" : "")</label>
                    <select id="gender" name="Gender" disabled="@(Model.HasParticipants)">
                        <option value="all" selected="@(Model.Gender == "all" || string.IsNullOrEmpty(Model.Gender))">Mixta (All)</option>
                        <option value="m" selected="@(Model.Gender == "m")">Male</option>
                        <option value="f" selected="@(Model.Gender == "f")">Female</option>
                    </select>
                    @if (Model.HasParticipants) { <input type="hidden" name="Gender" value="@Model.Gender" /> }
                </div>
                <div class="form-group full">
                    <label>Imagen de la carrera</label>
                    @if (!string.IsNullOrEmpty(Model.CurrentImage))
                    {
                        <div style="margin-bottom: 10px;">
                            <p style="font-size: 0.85rem; color: #666; margin-bottom: 6px;">Imagen actual:</p>
                            <img src="@Model.CurrentImage" alt="Imagen actual" class="current-image" />
                        </div>
                    }
                    <div class="file-upload" onclick="document.getElementById('imageFile').click()">
                        <input id="imageFile" name="ImageFile" type="file" accept="image/*" onchange="previewImage(this)">
                        <div class="icon"><i class="fas fa-cloud-upload-alt"></i></div>
                        <p id="fileName">@(string.IsNullOrEmpty(Model.CurrentImage) ? "Haz clic para subir una imagen" : "Haz clic para cambiar la imagen")</p>
                        <img id="imagePreview" style="display:none; max-height:150px; margin-top:10px; border-radius:8px;" />
                    </div>
                </div>
            </div>
            <button type="submit" class="btn-submit">
                <i class="fas fa-check"></i> Update
            </button>
        </form>

        <a href="/Admin" class="btn-back">
            <i class="fas fa-arrow-left"></i> back to list
        </a>
    </div>

    <script>
        function previewImage(input) {
            var preview = document.getElementById('imagePreview');
            var fileName = document.getElementById('fileName');
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
                fileName.textContent = input.files[0].name;
            }
        }
    </script>
</body>
</html>
