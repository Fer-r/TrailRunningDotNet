@page
@model RacehubApi.Pages.Admin.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eventos - Panel de Administración</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #003d5c;
            --secondary: #007f80;
            --accent: #ff6b6b;
            --light: #f8f9fa;
            --dark: #1b2631;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #e8ecf1; }

        .admin-container {
            display: grid;
            grid-template-areas: "header" "main";
            grid-template-rows: auto 1fr;
            min-height: 100vh;
            padding: 20px;
            gap: 20px;
        }

        header {
            grid-area: header;
            background: var(--light);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .admin-title { color: var(--primary); font-size: 1.5rem; }

        main {
            grid-area: main;
            background: var(--light);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            overflow-x: auto;
        }

        .event-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .event-table th, .event-table td { padding: 12px; text-align: left; border-bottom: 1px solid #ddd; }
        .event-table th { background: var(--secondary); color: white; font-weight: bold; }
        .event-table tr:hover { background-color: #f1f1f1; }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent), #c0392b);
            border: none; color: white; padding: 10px 20px;
            border-radius: 8px; cursor: pointer; text-decoration: none;
            transition: transform 0.2s ease; font-weight: 600; display: inline-block;
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(231, 76, 60, 0.3); }

        .btn-new {
            background: linear-gradient(135deg, var(--secondary), var(--primary));
            border: none; color: white; padding: 10px 20px;
            border-radius: 8px; cursor: pointer; text-decoration: none;
            transition: transform 0.2s ease; font-weight: 600;
        }
        .btn-new:hover { transform: translateY(-2px); box-shadow: 0 4px 10px rgba(0, 127, 128, 0.3); }

        .action-buttons a, .action-buttons button {
            margin: 0 4px; text-decoration: none; font-weight: 600; font-size: 0.85rem;
        }
        .action-buttons a { color: var(--primary); }
        .action-buttons a:hover { color: var(--accent); }

        .btn-delete {
            color: var(--accent); border: none; background: none;
            cursor: pointer; font-weight: 600; padding: 0; font-size: 0.85rem;
        }
        .btn-delete:hover { color: #c0392b; }

        .status-badge { padding: 4px 10px; border-radius: 5px; font-weight: bold; color: white; font-size: 0.85rem; }

        .image-thumbnail { max-width: 80px; height: auto; border-radius: 4px; }

        .alert-success {
            background: #d4edda; border: 1px solid #c3e6cb; color: #155724;
            padding: 12px 20px; border-radius: 8px; margin-bottom: 15px;
        }
        .alert-info {
            text-align: center; font-size: 1.1rem; color: var(--accent); padding: 20px;
        }
        .nav-links { display: flex; gap: 10px; margin-bottom: 10px; padding: 0 20px; }
        .nav-links a { color: var(--primary); text-decoration: none; font-weight: 600; }
        .nav-links a:hover { color: var(--accent); }
    </style>
</head>
<body>
    <div style="margin-top: 20px; padding: 0 20px; display: flex; gap: 10px;">
        <a href="http://localhost:5173" class="btn-primary">
            <i class="fas fa-arrow-left"></i> Volver al Frontend
        </a>
        <a href="/Admin/Logout" class="btn-delete" style="text-decoration: none; padding: 8px 16px;">
            <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
        </a>
    </div>

    <div class="admin-container">
        <header>
            <h1 class="admin-title">
                <i class="fas fa-calendar-alt"></i>
                Eventos de TrailRunning
            </h1>
            <a href="/Admin/CreateRace" class="btn-new">
                <i class="fas fa-plus"></i> Nuevo Evento
            </a>
        </header>

        <main>
            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="alert-success">✅ @Model.SuccessMessage</div>
            }

            <table class="event-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Fecha</th>
                        <th>Distancia (km)</th>
                        <th>Ubicación</th>
                        <th>Coordenadas</th>
                        <th>Desnivel</th>
                        <th>Precio</th>
                        <th>Plazas</th>
                        <th>Inscritos</th>
                        <th>Estado</th>
                        <th>Categoría</th>
                        <th>Imagen</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TrailRunnings.Any())
                    {
                        @foreach (var race in Model.TrailRunnings)
                        {
                            <tr>
                                <td>@race.Id</td>
                                <td>@race.Name</td>
                                <td title="@race.Description">@(race.Description.Length > 40 ? race.Description[..40] + "..." : race.Description)</td>
                                <td>@race.Date.ToString("yyyy-MM-dd")</td>
                                <td>@race.DistanceKm</td>
                                <td>@race.Location</td>
                                <td>@(race.Coordinates ?? "—")</td>
                                <td>@(race.Unevenness?.ToString() ?? "—")</td>
                                <td>@race.EntryFee €</td>
                                <td>@race.AvailableSlots</td>
                                <td>
                                    <span style="font-weight: 600; color: @(race.TrailRunningParticipants.Count >= race.AvailableSlots ? "#e74c3c" : "#2ecc71");">@race.TrailRunningParticipants.Count</span> / @race.AvailableSlots
                                </td>
                                <td>
                                    @{
                                        var statusColor = race.Status switch
                                        {
                                            "open" => "#2ecc71",
                                            "closed" => "#f1c40f",
                                            "completed" => "#e74c3c",
                                            _ => "#95a5a6"
                                        };
                                    }
                                    <span class="status-badge" style="background-color: @statusColor;">
                                        @race.Status.ToUpper()
                                    </span>
                                </td>
                                <td>@(race.Category ?? "N/A")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(race.Image))
                                    {
                                        <img src="@race.Image" alt="@race.Name" class="image-thumbnail">
                                    }
                                    else
                                    {
                                        <span>Sin imagen</span>
                                    }
                                </td>
                                <td class="action-buttons">
                                    <a href="/Admin/EditRace?id=@race.Id">
                                        <i class="fas fa-edit"></i> Editar
                                    </a>
                                    <form method="post" asp-page-handler="Delete" style="display: inline;"
                                          onsubmit="return confirm('¿Estás seguro que deseas eliminar este evento?');">
                                        <input type="hidden" name="id" value="@race.Id" />
                                        <button type="submit" class="btn-delete">
                                            <i class="fas fa-trash"></i> Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="15" class="alert-info">No hay eventos registrados</td>
                        </tr>
                    }
                </tbody>
            </table>
        </main>
    </div>
</body>
</html>
